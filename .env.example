# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# This must be a Gmail App Password (16 characters, no spaces), NOT your normal
# Google account password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on first).
#
# Nothing else in the project stores this value, and it is never logged.

FI_AGENT_SMTP_PASSWORD=
